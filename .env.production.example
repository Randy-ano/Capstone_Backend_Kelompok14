# Variabel service app (backend Laravel) di Railway. Salin ke tab "Variables" service (Raw Editor), lalu
# ganti nilai bertanda <...>. JANGAN isi APP_KEY, password, atau kredensial asli di file ini; file ini di-commit.
# Langkah lengkap: DEPLOY.md.
#
# ${{...}} adalah reference variable Railway: nilainya diisi Railway saat deploy.
#   ${{MySQL.MYSQL_URL}}       = URL koneksi service database bernama "MySQL" (ganti "MySQL" jika nama service berbeda)
#   ${{RAILWAY_PUBLIC_DOMAIN}} = domain publik service ini, mis. intellisys-api.up.railway.app

# --- Aplikasi ---
APP_NAME="Intellisys Talent Hub"
APP_ENV=production
APP_DEBUG=false
# Buat di laptop: php artisan key:generate --show  → tempel hasilnya (diawali base64:) langsung di Railway.
APP_KEY=<isi dari php artisan key:generate --show>
# Alamat publik backend (https). Dipakai untuk URL yang dibuat Laravel.
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Alamat frontend Vercel, tanpa garis miring di akhir. Boleh beberapa, dipisah koma (mis. domain produksi dan
# domain kustom). Origin pertama dipakai untuk tautan di email (reset password). http://localhost:5173 selalu
# diizinkan CORS tanpa perlu ditulis di sini.
FRONTEND_URL=https://<nama-proyek>.vercel.app

# --- Database (service MySQL Railway) ---
DB_CONNECTION=mysql
DB_URL=${{MySQL.MYSQL_URL}}

# --- Sesi, cache, antrean ---
SESSION_DRIVER=database
CACHE_STORE=database
# sync: job (email notifikasi) dijalankan langsung tanpa service worker terpisah. Hemat kredit, dan file yang
# dibuat selama request tetap tersimpan di volume service app.
QUEUE_CONNECTION=sync

# --- File ---
# Disk "local" = storage/app/private. Pasang Volume Railway di /app/storage/app agar file tidak hilang saat deploy.
FILESYSTEM_DISK=local

# --- Log ---
# stderr: log tampil di tab "Logs" Railway (tidak ditulis ke file).
LOG_CHANNEL=stderr
# debug diperlukan selama MAIL_MAILER=log: isi email ditulis di level debug. Boleh dinaikkan ke info setelah
# memakai Brevo.
LOG_LEVEL=debug

# --- Email ---
# Railway paket Trial/Hobby memblokir SMTP keluar, jadi email dikirim lewat Brevo HTTP API (HTTPS).
# log : email tidak dikirim, isinya tampil di tab Logs Railway (cadangan untuk demo lupa password).
# brevo: email terkirim sungguhan. Langkah (detail di DEPLOY.md bagian Email):
#   1. https://app.brevo.com → menu profil → SMTP & API → tab "API Keys" → Generate a new API key,
#      salin key (diawali "xkeysib-") ke BREVO_API_KEY di Railway. Jangan tulis key di file ini / repo.
#   2. Senders, Domains & Dedicated IPs → Senders → Add a sender → klik tautan verifikasi dari Brevo.
#   3. MAIL_FROM_ADDRESS harus alamat pengirim yang SUDAH diverifikasi di Brevo.
# Isi variabel yang sama juga di service cron (pengingat harian mengirim email).
MAIL_MAILER=brevo
MAIL_FROM_ADDRESS="alamat-terverifikasi@contoh.com"
MAIL_FROM_NAME="Intellisys Talent Hub"
BREVO_API_KEY=

# --- Deploy ---
# true: saat container start, SEMUA DATA DIHAPUS (database + file unggahan) lalu diisi ulang data demo
# (php artisan migrate:fresh --seed). Hanya sekali per deployment. Pakai saat deploy pertama dan sebelum
# presentasi, lalu kembalikan ke false. Lihat DEPLOY.md.
SEED_DEMO=false
# Migrasi sudah dijalankan railway/init-app.sh, jadi migrasi otomatis bawaan Railpack dimatikan.
RAILPACK_SKIP_MIGRATIONS=true
