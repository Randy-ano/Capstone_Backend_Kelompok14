APP_NAME="Intellisys Talent Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
FRONTEND_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=intellisys_talent_hub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. Default "log": email tidak dikirim, isinya ditulis ke storage/logs/laravel.log
# (cukup untuk pengembangan & uji lupa password). Untuk mengirim sungguhan, isi salah satu contoh di bawah
# di file .env (BUKAN di .env.example) lalu jalankan "php artisan config:clear". Jangan commit kredensial.
#
# Mailtrap (sandbox, email tertangkap di inbox Mailtrap, tidak sampai ke penerima asli):
#   MAIL_MAILER=smtp
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USERNAME=<username dari Mailtrap → Inboxes → SMTP Settings>
#   MAIL_PASSWORD=<password dari halaman yang sama>
#
# Gmail (terkirim sungguhan; akun Google harus memakai Verifikasi 2 Langkah lalu buat App Password):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=465
#   MAIL_USERNAME=alamat@gmail.com
#   MAIL_PASSWORD=<App Password 16 huruf, tanpa spasi>
#   MAIL_FROM_ADDRESS=alamat@gmail.com
#
# Brevo HTTP API (dipakai di produksi Railway karena SMTP keluar diblokir; lihat DEPLOY.md bagian Email):
#   1. Daftar/masuk di https://app.brevo.com → menu profil → SMTP & API → tab "API Keys" → Generate a new API key.
#      Salin key (diawali "xkeysib-") ke BREVO_API_KEY. Key hanya tampil sekali; jangan commit.
#   2. Senders, Domains & Dedicated IPs → Senders → Add a sender → verifikasi lewat email yang dikirim Brevo.
#   3. MAIL_MAILER=brevo, MAIL_FROM_ADDRESS=<alamat pengirim yang SUDAH diverifikasi di Brevo>.
#      Alamat yang belum diverifikasi ditolak Brevo (email tidak terkirim, error tercatat di log).
#   MAIL_MAILER=brevo
#   MAIL_FROM_ADDRESS=alamat-terverifikasi@contoh.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
